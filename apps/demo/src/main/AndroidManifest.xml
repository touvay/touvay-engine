<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Touvay Engine Developer Console"
        android:theme="@android:style/Theme.Material.Light">

        <!-- Explicit demo-only trust configuration. Production hosts do not inherit it. -->
        <meta-data
            android:name="com.touvay.engine.demo.ENABLED"
            android:value="true" />
        <meta-data
            android:name="com.touvay.engine.demo.PACK_ID"
            android:value="${touvayDemoPackId}" />
        <meta-data
            android:name="com.touvay.engine.demo.KEY_ID"
            android:value="${touvayDemoKeyId}" />
        <meta-data
            android:name="com.touvay.engine.demo.PUBLIC_KEY_BASE64"
            android:value="${touvayDemoPublicKeyBase64}" />
        <meta-data
            android:name="com.touvay.engine.demo.SOURCE_DIRECTORY"
            android:value="touvay-demo-pack" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TouvayEngineService is contributed by the engine-service manifest merge. -->
    </application>

</manifest>
